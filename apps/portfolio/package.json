{
  "name": "verified-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node ./scripts/start-local.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "npm run github:test && npm run markdown:test && npm run security:test && npm run observability:test && npm run upload:test",
    "test:integration": "npm run admin:test && npm run admin:test:sessions && npm run admin:verify-audit && npm run github:test:lease && npm run homepage:test && npm run projects:lifecycle:test && npm run documents:test",
    "test:e2e": "node ./scripts/test-public-e2e.mjs",
    "scan:secrets": "node ./scripts/scan-secrets.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run format:check && npm run lint -- --quiet && npm run typecheck && npm run test:unit && npm run scan:secrets",
    "verify": "npm run quality && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:secure": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/migrate-secure.ps1",
    "db:verify": "node ./scripts/verify-database.mjs",
    "db:verify:secure": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-database-secure.ps1",
    "github:sync": "node --env-file=.env --import tsx ./scripts/sync-github.ts",
    "github:sync-readmes": "node --env-file=.env --import tsx ./scripts/sync-readmes.ts",
    "github:test": "node --import tsx ./scripts/test-github-client.ts && node --import tsx ./scripts/test-service-auth.ts",
    "github:test:account": "node --env-file=.env --import tsx ./scripts/test-github-account-constraint.ts",
    "github:test:preservation": "node --env-file=.env --import tsx ./scripts/test-github-editorial-preservation.ts",
    "github:test:reconciliation": "node --env-file=.env --import tsx ./scripts/test-github-reconciliation.ts",
    "github:test:alert": "node --import tsx ./scripts/test-github-alert.ts",
    "github:test:lease": "node --env-file=.env --import tsx ./scripts/test-github-lease.ts",
    "admin:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-admin.ps1",
    "admin:bootstrap": "node --env-file=.env --import tsx ./scripts/bootstrap-admin.ts",
    "admin:test": "node --env-file=.env --import tsx ./scripts/test-auth-boundary.ts",
    "admin:test:sessions": "node --env-file=.env --import tsx ./scripts/test-session-security.ts",
    "admin:test:recovery": "node --env-file=.env --import tsx ./scripts/test-backup-code-recovery.ts",
    "admin:verify-audit": "node --env-file=.env --import tsx ./scripts/verify-admin-audit.ts",
    "markdown:test": "node --import tsx ./scripts/test-safe-markdown.tsx",
    "security:test": "node --import tsx ./scripts/test-security-boundaries.ts && node ./scripts/test-admin-policy-matrix.mjs",
    "observability:test": "node --import tsx ./scripts/test-observability.ts",
    "homepage:test": "node --env-file=.env --import tsx ./scripts/test-homepage-sections.ts",
    "projects:lifecycle:test": "node --env-file=.env --import tsx ./scripts/test-project-lifecycle.ts",
    "upload:test": "node --import tsx ./scripts/test-upload-policy.ts",
    "documents:test": "node --env-file=.env --import tsx ./scripts/test-document-access.ts",
    "contact:test": "node --import tsx ./scripts/test-contact-integrations.ts && node --env-file=.env --import tsx ./scripts/test-contact-abuse.ts",
    "ai:test": "node --env-file=.env --import tsx ./scripts/test-ai-governance.ts",
    "operations:test": "node --env-file=.env --import tsx ./scripts/test-operations-restore.ts",
    "operations:smoke": "node ./scripts/operations-smoke.mjs",
    "documents:scan:local": "node --env-file=.env --import tsx ./scripts/scan-quarantine-local.ts",
    "documents:scan:remote": "node --env-file=.env --import tsx ./scripts/scan-quarantine-local.ts --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@neondatabase/serverless": "^1.2.0",
    "@shadcn/react": "^0.3.0",
    "baseline-browser-mapping": "2.11.28",
    "better-auth": "^1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "source-map-js": "1.2.2",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.6.2",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
