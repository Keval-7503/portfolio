# Public origin, for example http://127.0.0.1:8787 in local development.
APP_ORIGIN=

# PostgreSQL connection string supplied by the selected Neon project.
DATABASE_URL=

# Runtime-only single owner allow-list. Never commit the real email value.
ADMIN_EMAIL_ALLOWLIST=

# Generate a high-entropy value of at least 32 characters.
BETTER_AUTH_SECRET=

# Optional integrations; leave unset for honest setup-required states.
GITHUB_USERNAME=Keval-7503
GITHUB_ACCOUNT_ID=80451128
GITHUB_TOKEN=
# Server-only credential for the internal scheduled-sync endpoint (minimum 32 characters).
GITHUB_SYNC_SECRET=
GITHUB_SYNC_ALERT_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_NOTIFICATION_FROM=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set only for an intentional owner-operated production quarantine scan.
ALLOW_REMOTE_DOCUMENT_SCAN=
